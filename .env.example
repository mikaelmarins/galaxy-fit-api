# ==============================================================================
# GALAXY FIT API - VARIÁVEIS DE AMBIENTE (BACKEND)
# Copie este arquivo para .env na raiz da API antes de rodar o servidor
# ==============================================================================

# Configurações do Servidor
PORT=3001
NODE_ENV=development
CORS_ORIGIN=*

# Chave secreta para geração e validação de tokens JWT
JWT_SECRET=gere_uma_chave_secreta_jwt_longa_e_aleatoria_aqui

# Conexão com o Banco de Dados (Oracle Autonomous Database)
ORACLE_USER=ADMIN
ORACLE_PASSWORD=sua_senha_do_banco_aqui
ORACLE_CONNECTION_STRING=(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=adb.sa-saopaulo-1.oraclecloud.com))(connect_data=(service_name=seu_servico_high))(security=(ssl_server_dn_match=yes)))

# Caso utilize Oracle Wallet localmente:
# TNS_ADMIN=/caminho/para/pasta/da/wallet
